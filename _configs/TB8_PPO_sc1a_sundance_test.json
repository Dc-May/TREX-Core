{
  "version": "3.7.0",
  "study": {
    "name": "sundance_Entropy_Warmup_NewAdv",
      "description": "",
      "start_datetime": "2015-06-01 0:0:0",
      "start_datetime_sequence": "sequential",
      "timezone": "America/Vancouver",
      "days": 7,
      "time_step_size": 3600,
      "generations": 2000,
      "profiles_db_location": "postgresql://postgres:postgres@stargate/SunDance"
//      "sim_root": "/home/trex/sim/"
    },
  "server": {
      "host": "",
      "port": 5210
    },
  "training": {
//   "hyperparameters": {
//      // "entropy_reg": {"start": 0.1, "stop": 0.01, "num": 3},
////      "kl_stop": {"start": 0.1, "stop": 0.01, "num": 3},
////      "actor_hidden": [[64,64], [128,128],[256, 256]],
////     "warmup_actor": [true]
//    },
    "curriculum": {
      "42": {
        "anneal": {
         "warmup_actor":  [false, "set"],
         "entropy_reg": [0.98,"multiply", 0.00]
          }
        }
      }
    },

    "market": {
      "id": "",
      "type": "MicroTE3B",
      "close_steps": 2,
      "grid": {
        "price": 0.069,
        "fee_ratio": 1.1
      }
    },
    "participants": {
      "GreedyBaseline": { //serves as baseline for evaluation for battery tests
        "type": "Residential",
        "trader": {
          "track_metrics": true,
          "type": "greedy_battery",
          "bid_price": 0.14,
          "ask_price": 0.07,
          "P_max": 3000,
          "actions": [
            "storage"
          ],
          "learning": true,
          "limit_actions": true,
          "reward_function": "net_profit",
          "use_synthetic_profile": "SunDance_10011"

        },
        "load": {
          "scale": 1
        },
        "generation": {
          "scale": 1
        },
        "storage": {
          "type": "Bess",
          "capacity": 6000,
          "power": 3000,
          "efficiency": 1,
          "monthly_sdr": 0
        }
      },
      "NoWarmup_EntropyFloor": {
        "type": "Residential",
        "trader": {

          "track_metrics": true,
          "type": "ppo_trader_multivar",
          "bid_price": 0.14,
          "ask_price": 0.07,
          "P_max": 3000, //max output for bess
          "actions": ["storage"], // 'price', 'quantity'
          "learning": true,
          "observations": ["generation", "load", "soc", "time_sin_hour", "time_cos_hour"],

          "use_early_stop_critic": true,
          "alpha_critic": 5e-4,
          "critic_hidden": [64,64],
          "critic_patience": 60,
          "critic_type": "GRU",

          "warmup_actor": false,
          "warmup_targets": [false, false],

          "use_early_stop_actor": true,
          "alpha_actor": 1.5e-4,
          "actor_type": "GRU",
          "actor_hidden": [64,64],
          "policy_clip": 0.2,
          "kl_stop": 0.02,  // try with 0.1 next
          "gamma": 0.99,
          "gae_lambda": 0.95,
          "normalize_advantages": true,
          "entropy_reg": 0.01, //Entropy starting value, will probably need to be adjusted depending on schedule. ATM recommended to anneal from close to 1 to 1e-3

          "g_grad_norm": 0.5, //https://iclr-blog-track.github.io/2022/03/25/ppo-implementation-details/, detail 11
          "batch_size": 64,

          // might wanna tweak the next 3
          "experience_replay_buffer_length": 336, // longer might be safer, like 1440
          "trajectory_length": 24, //trajectory_length >>= main seasonalityof data (1.5-2 days, likely)
          "burn_in": 12,             //BURN_IN >= main seasonalityof data (1day,likely)
          "max_train_steps": 80,

          "limit_actions": true,

          "reward_function": "net_profit",
         "use_synthetic_profile": "SunDance_10011"

        },
        "load": {
          "scale": 1
        },
        "generation": {
          "scale": 1
        },
        "storage": {
